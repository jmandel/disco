{
  "name": "disco",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright + a SQLite log + a folder convention: drive an unfamiliar web app, keep every wait short and named, and leave a pack behind.",
  "engines": { "node": ">=24" },
  "bin": { "disco": "./disco" },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "gauntlet": "bun gauntlet/server.ts",
    "check": "node scripts/run-check.ts"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bun-types": "latest",
    "typescript": "^5.6.0"
  }
}
