{
  "name": "disco",
  "version": "4.0.0-dev",
  "private": true,
  "type": "module",
  "description": "Three verbs for a frontier agent driving a web app it has never seen: look, act, sql. Playwright unwrapped, an always-on SQLite log, a two-file pack.",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "disco": "./disco"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "gauntlet": "bun gauntlet/server.ts",
    "stats": "node scripts/stats.ts",
    "export": "node scripts/export.ts"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bun-types": "latest",
    "typescript": "^5.6.0"
  }
}
